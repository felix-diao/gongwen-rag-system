# 应用配置
APP_NAME=公文大模型RAG系统
APP_VERSION=1.0.0
DEBUG=false

# 数据库配置
DATABASE_URL=postgresql://gongwen_user:your_password@localhost:5432/gongwen_rag

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# 向量维度
EMBEDDING_DIM=1024

# LLM 配置（文本摘要、纪要生成等；勿与下方 QWEN_ASR_HTTP_CHAT_URL 语音转写混用）
LLM_API_URL=http://your-llm-service:8000/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=gongwen-llm-v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=180
# 默认 false：不继承系统 HTTP(S)_PROXY，避免本地失效代理影响调用
LLM_USE_ENV_PROXY=false
# 如需固定代理可设置，例如 http://127.0.0.1:7890
LLM_PROXY_URL=

# Embedding 配置
EMBEDDING_API_URL=http://your-embed-service:8001/v1/embeddings
EMBEDDING_MODEL=gongwen-embed-v1

# JWT 配置
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 文件存储
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600

# RAG 配置
DEFAULT_TOP_K=6
PUBLIC_WEIGHT=0.6
PRIVATE_WEIGHT=0.4
CONVERSATION_WEIGHT=0.3

# 分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 腾讯会议配置
TENCENT_MEETING_APP_ID=your_app_id
TENCENT_MEETING_SDK_ID=your_sdk_id
TENCENT_MEETING_SECRET_ID=your_secret_id
TENCENT_MEETING_SECRET_KEY=your_secret_key
TENCENT_MEETING_API_URL=https://api.meeting.qq.com/v1

# 日志保留时间
LOG_KEEP_DAYS=30

# ---------- 本地会议纪要 / Qwen ASR（incremental_merge 脚本同源）----------
# false=实时走 WS；true=HTTP 滑窗 + merge_pair。CHUNK/OVERLAP：实时与整文件 ffmpeg 切片共用。
QWEN_ASR_API_KEY=
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_WS_URL=ws://127.0.0.1:8888/api-ws/v1/realtime
QWEN_ASR_LIVE_FORCE_HTTP_CHUNK=true
QWEN_ASR_CHUNK_SEC=6.0
QWEN_ASR_OVERLAP_SEC=1.0
# 语音转写 chat/completions（audio_url），勿填 LLM_API_URL
QWEN_ASR_HTTP_CHAT_URL=
# 可选：QWEN_ASR_HTTP_CHAT_MODEL / QWEN_ASR_HTTP_CHAT_API_KEY / TIMEOUT / MAX_TOKENS
# 可选：QWEN_ASR_LANGUAGE、VAD、SILENCE、AUDIO_SAVE_DIR（见 app/config.py 默认值）
# 固定分段 wav 根目录，需由 nginx 暴露给 ASR 服务拉取
QWEN_ASR_HTTP_ROOT_DIR=/mnt/data/gongwen_runtime_data/asr_chunks
# ASR 可拉取分段 wav 的 URL 前缀（无尾斜杠），由 nginx 暴露
QWEN_ASR_FILE_HTTP_PUBLIC_BASE=http://127.0.0.1:8010
LOCAL_TOS_BUCKET=meeting-record-local-temp